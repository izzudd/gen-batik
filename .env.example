# Port number for ComfyUI server
COMFY_PORT=8188

# SSH server address/hostname
SSH_SERVER=your-server.example.com

# SSH username for remote access
SSH_USER=your-username

# SSH port number for remote connection
SSH_PORT=22

# Public app URL
APP_URL=http://localhost:3000

# Cloudflare Turnstile keys (required to queue generations)
NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NUXT_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
